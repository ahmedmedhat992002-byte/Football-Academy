# =========================================================================
# FIFA FC ACADEMY — ENVIRONMENT CONFIGURATION
# =========================================================================

# Academy Brand
NEXT_PUBLIC_APP_NAME="FIFA FC ACADEMY | أكاديمية كرة القدم الاحترافية"
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP

# =========================================================================
# FIREBASE CLIENT CONFIGURATION (من Project Settings في Firebase Console)
# =========================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-academy-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-academy-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-academy-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# =========================================================================
# FIREBASE ADMIN SDK (من Project Settings -> Service accounts -> Generate new private key)
# =========================================================================
FIREBASE_PROJECT_ID=your-academy-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-academy-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# =========================================================================
# OPTIONAL: SUPABASE CONFIGURATION (إن وُجد)
# =========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
